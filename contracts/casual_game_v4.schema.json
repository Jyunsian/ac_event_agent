{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_version",
    "windows_hours",
    "max_discovery_candidates",
    "max_candidates",
    "max_finalists",
    "seed",
    "min_group_users",
    "bootstrap_replicates",
    "exploration_fraction"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "analysis_version": {
      "const": "4.0-time-aware"
    },
    "windows_hours": {
      "const": [
        24,
        48,
        72,
        96,
        120,
        144
      ]
    },
    "max_discovery_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "max_finalists": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "min_group_users": {
      "type": "integer",
      "minimum": 2
    },
    "bootstrap_replicates": {
      "const": 1000
    },
    "exploration_fraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "exclusiveMaximum": 1
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "number"
        }
      }
    },
    "existing_rules": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "rule",
          "deadline_hours"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "rule": {
            "type": "object"
          },
          "deadline_hours": {
            "enum": [
              24,
              48,
              72,
              96,
              120,
              144
            ]
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
