# Server-only configuration; fill only in a local .env, never in VITE_*.
DATABASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=ac-event
AWS_DEFAULT_REGION=us-east-1
MAX_UPLOAD_BYTES=5368709120
# Analysis limits are server-owned. Watchdog samples RSS/disk; these are not cgroup quotas.
WORKER_RSS_MB=1536
DUCKDB_MEMORY_MB=256
WORKER_THREADS=2
DISK_RESERVE_BYTES=2147483648
MAX_WORKDIR_BYTES=4294967296
WORKER_TASK_TIMEOUT_SECONDS=900
WORKER_CPU_SECONDS=600
# Omit WORKER_WORK_ROOT to use a dedicated ac-event-work directory under the OS temp folder.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Agent wall-clock limit (1000..600000 ms); GLM live test uses 300000.
AGENT_TIMEOUT_MS=300000
API_PORT=8080
AGENT_PORT=8081
AGENT_INTERNAL_TOKEN=
AGENT_API_BASE_URL=http://127.0.0.1:8080
AGENT_HEALTH_URL=http://127.0.0.1:8081/health
