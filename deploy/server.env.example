# Copy outside the build context to a private chmod 600 file. Do not commit filled values.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/ac_event
S3_BUCKET=ac-event
# Empty endpoint uses AWS; custom endpoint must also be reachable by the upload browser.
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENT_INTERNAL_TOKEN=
MAX_UPLOAD_BYTES=5368709120
WORKER_RSS_MB=1536
DUCKDB_MEMORY_MB=256
WORKER_THREADS=2
DISK_RESERVE_BYTES=2147483648
MAX_WORKDIR_BYTES=4294967296
WORKER_TASK_TIMEOUT_SECONDS=900
WORKER_CPU_SECONDS=600
